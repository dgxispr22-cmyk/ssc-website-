<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shahzad Shopping Centre</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Top Header Navigation -->
    <header class="navbar">
        <div class="nav-left">
            <button class="menu-btn" aria-label="Menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
            <h1 class="brand-title">SHAHZAD SHOPPING CENTRE</h1>
        </div>

        <nav class="nav-categories">
            <button class="cat-link active" onclick="switchCategory('men')">MEN</button>
            <button class="cat-link" onclick="switchCategory('women')">WOMEN</button>
            <button class="cat-link" onclick="switchCategory('boy')">BOY</button>
            <button class="cat-link" onclick="switchCategory('girl')">GIRL</button>
            <button class="cat-link" onclick="switchCategory('newborn')">NEW BORN</button>
        </nav>
    </header>

    <!-- Main Hero Slider Display -->
    <main class="hero-container">
        <div id="hero-banner" class="hero-banner">
            <div class="banner-overlay">
                <h2 id="banner-title">SUMMER COLLECTION</h2>
            </div>
        </div>
    </main>

    <script src="script.js"></script>
</body>
</html>
