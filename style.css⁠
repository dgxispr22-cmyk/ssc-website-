* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: #f8f9fa;
    color: #333;
}

/* Navbar Styling */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #000;
    color: #fff;
    padding: 12px 20px;
    position: sticky;
    top: 0;
    z-index: 100;
}

.nav-left {
    display: flex;
    align-items: center;
    gap: 15px;
}

.menu-btn {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.menu-btn span {
    display: block;
    width: 22px;
    height: 2px;
    background-color: #fff;
}

.brand-title {
    font-size: 1.1rem;
    letter-spacing: 1px;
}

.nav-categories {
    display: flex;
    gap: 15px;
}

.cat-link {
    background: none;
    border: none;
    color: #aaa;
    font-weight: 600;
    cursor: pointer;
    padding: 5px 8px;
    transition: 0.3s;
}

.cat-link.active, .cat-link:hover {
    color: #fff;
    border-bottom: 2px solid #fff;
}

/* Sidebar Drawer */
.sidebar {
    position: fixed;
    top: 0;
    left: -280px;
    width: 280px;
    height: 100%;
    background-color: #111;
    color: #fff;
    z-index: 1000;
    transition: 0.3s ease-in-out;
    padding: 20px;
}

.sidebar.active {
    left: 0;
}

.close-btn {
    background: none;
    border: none;
    color: #fff;
    font-size: 2rem;
    float: right;
    cursor: pointer;
}

.sidebar-header {
    margin-top: 40px;
    margin-bottom: 30px;
    border-bottom: 1px solid #333;
    padding-bottom: 10px;
}

.sidebar-links {
    list-style: none;
}

.sidebar-links li {
    margin-bottom: 20px;
}

.sidebar-links a {
    color: #ccc;
    text-decoration: none;
    font-size: 1.1rem;
    transition: 0.2s;
}

.sidebar-links a:hover {
    color: #fff;
}

.overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    display: none;
    z-index: 999;
}

.overlay.active {
    display: block;
}

/* Hero Banner Section */
.hero-container {
    width: 100%;
    height: 85vh;
}

.hero-banner {
    width: 100%;
    height: 100%;
    /* Apni photo ka naam yahan rakhein */
    background: url('banner.jpg') no-repeat center center/contain;
    background-color: #fff;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    padding-bottom: 60px;
    text-align: center;
    position: relative;
}

.banner-content h2 {
    font-size: 2rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 5px;
}

.banner-content p {
    font-size: 1rem;
    color: #555;
    margin-bottom: 20px;
}

.explore-btn {
    display: inline-block;
    padding: 12px 35px;
    background-color: #000;
    color: #fff;
    text-decoration: none;
    font-weight: bold;
    border-radius: 4px;
    letter-spacing: 1px;
    transition: 0.3s;
}

.explore-btn:hover {
    background-color: #333;
    transform: translateY(-2px);
}
