// Initial Set
document.addEventListener("DOMContentLoaded", () => {
    switchCategory('men');
});

function switchCategory(category) {
    // Active class update for buttons
    const buttons = document.querySelectorAll('.cat-link');
    buttons.forEach(btn => btn.classList.remove('active'));

    event.currentTarget?.classList.add('active');

    // Update Banner Image and Title
    const banner = document.getElementById('hero-banner');
    const title = document.getElementById('banner-title');

    if (bannerData[category]) {
        banner.style.backgroundImage = `url('${bannerData[category].image}')`;
        title.innerText = bannerData[category].title;
    }
}
